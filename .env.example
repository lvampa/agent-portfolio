# Copy to .env at the repo root and fill in. Compose reads it for compose.yaml.
# If you already have Postgres and n8n volumes, keep the DB values they were created with.

# Postgres, used by n8n
DB_USER=n8n
DB_PASSWORD=change-me
DB_NAME=n8n

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_CORS_ORIGIN=http://localhost:3001
NODE_ENV=development

# Agent service. Compose refuses to start while any of these is empty.
GOOGLE_API_KEY=
PINECONE_API_KEY=
LANGSMITH_API_KEY=
