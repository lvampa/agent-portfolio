    {
      "parameters": {
        "jsCode": "const body = $json.body ?? {};\n\n// Caps keep one request cheap on the free model tier.\nconst MAX = { chatInput: 2000, name: 100, field: 200 };\nconst UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\nconst sessionId = String(body.sessionId ?? '');\nif (!UUID.test(sessionId)) {\n  throw new Error('Invalid sessionId');\n}\n\nconst chatInput = String(body.chatInput ?? '').trim();\nif (!chatInput) {\n  throw new Error('Empty chatInput');\n}\n\nconst cap = (value, max) => (typeof value === 'string' ? value.slice(0, max) : null);\n\nconst client = body.client ?? {};\nconst fields = ['city', 'country', 'organization', 'browser', 'os', 'device', 'referer', 'botRisk'];\nconst cappedClient = Object.fromEntries(fields.map((key) => [key, cap(client[key], MAX.field)]));\n\nreturn [\n  {\n    json: {\n      chatInput: chatInput.slice(0, MAX.chatInput),\n      sessionId,\n      name: cap(body.name, MAX.name),\n      client: cappedClient,\n    },\n  },\n];"
      },
